using EreIdentity.Application.Interfaces;
using EreIdentity.Domain.Entities;
using EreIdentity.Domain.Policies;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace EreIdentity.Api.Controllers;

[ApiController]
[Route("api/applications")]
public sealed class ApplicationController : ControllerBase
{
    private const string BoostClientId = "Boost";

    private readonly IUserProvisioningRepository _repository;
    private readonly ILogger<ApplicationController> _logger;

    public ApplicationController(
        IUserProvisioningRepository repository,
        ILogger<ApplicationController> logger)
    {
        _repository = repository;
        _logger = logger;
    }

    /// <summary>
    /// Creates the Keycloak/C-EntryX configuration for the authenticated client application.
    /// </summary>
    [HttpPost]
    [Authorize(Policy = IdentityPolicyDefinition.Writer)]
    [ProducesResponseType(typeof(ApplicationConfigurationResult), StatusCodes.Status202Accepted)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    [ProducesResponseType(StatusCodes.Status403Forbidden)]
    [ProducesResponseType(StatusCodes.Status409Conflict)]
    public async Task<ActionResult<ApplicationConfigurationResult>> CreateApplicationConfig(
        [FromBody] ApplicationInfoCommand command)
    {
        if (command is null)
        {
            return BadRequest("The request body is required.");
        }

        if (TryGetClientId(command, out var clientId) is { } clientError)
        {
            return clientError;
        }

        var existingApplication = await _repository.GetApplicationInfoByClientIdAsync(clientId);

        if (existingApplication is not null)
        {
            return Conflict("Application configuration already exists.");
        }

        var applicationInfo = new ApplicationInfo
        {
            ClientId = clientId,
            KeycloakConfiguration = command.KeyCloakServiceAccount,
            CallbackUrl = command.CallBackUrl,
            UpdatedDateTime = DateTime.UtcNow
        };

        await _repository.CreateApplicationInfoAsync(applicationInfo);

        _logger.LogInformation(
            "Application configuration created for client {ClientId}.",
            clientId);

        return Accepted(ToResult(applicationInfo));
    }

    /// <summary>
    /// Updates the Keycloak/C-EntryX configuration for the authenticated client application.
    /// </summary>
    [HttpPatch]
    [Authorize(Policy = IdentityPolicyDefinition.Writer)]
    [ProducesResponseType(typeof(ApplicationConfigurationResult), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    [ProducesResponseType(StatusCodes.Status403Forbidden)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    [ProducesResponseType(StatusCodes.Status500InternalServerError)]
    public async Task<ActionResult<ApplicationConfigurationResult>> UpdateApplicationConfig(
        [FromBody] ApplicationInfoCommand command)
    {
        if (command is null)
        {
            return BadRequest("The request body is required.");
        }

        if (TryGetClientId(command, out var clientId) is { } clientError)
        {
            return clientError;
        }

        var application = await _repository.GetApplicationInfoByClientIdAsync(clientId);

        if (application is null)
        {
            return NotFound();
        }

        var updated = await _repository.UpdateApplicationInfoAsync(clientId, command);

        if (!updated)
        {
            return StatusCode(
                StatusCodes.Status500InternalServerError,
                "Application configuration was not updated.");
        }

        var updatedApplication = await _repository.GetApplicationInfoByClientIdAsync(clientId);

        _logger.LogInformation(
            "Application configuration updated for client {ClientId}.",
            clientId);

        return Ok(ToResult(updatedApplication!));
    }

    /// <summary>
    /// Deletes the Keycloak/C-EntryX configuration for the authenticated client application.
    /// </summary>
    [HttpDelete]
    [Authorize(Policy = IdentityPolicyDefinition.Writer)]
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status403Forbidden)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    [ProducesResponseType(StatusCodes.Status500InternalServerError)]
    public async Task<ActionResult> DeleteApplicationConfig()
    {
        if (TryGetClientId(out var clientId) is { } clientError)
        {
            return clientError;
        }

        var application = await _repository.GetApplicationInfoByClientIdAsync(clientId);

        if (application is null)
        {
            return NotFound();
        }

        var deleted = await _repository.DeleteApplicationInfoAsync(clientId);

        if (!deleted)
        {
            return StatusCode(
                StatusCodes.Status500InternalServerError,
                "Application configuration was not deleted.");
        }

        _logger.LogInformation(
            "Application configuration deleted for client {ClientId}.",
            clientId);

        return Ok("Deleted");
    }

    private ActionResult? TryGetClientId(
        ApplicationInfoCommand command,
        out string clientId)
    {
        if (command.BoostAccess is true)
        {
            clientId = BoostClientId;
            return null;
        }

        return TryGetClientId(out clientId);
    }

    private ActionResult? TryGetClientId(out string clientId)
    {
        clientId = User?.Claims?
            .FirstOrDefault(claim => claim.Type == "client_id")
            ?.Value ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(clientId))
        {
            return null;
        }

        return Problem(
            title: "Client application not recognized.",
            statusCode: StatusCodes.Status403Forbidden);
    }

    private static ApplicationConfigurationResult ToResult(ApplicationInfo application)
    {
        return new ApplicationConfigurationResult
        {
            ClientId = application.ClientId,
            KeycloakConfiguration = application.KeycloakConfiguration,
            CallbackUrl = application.CallbackUrl,
            UpdatedAt = application.UpdatedDateTime
        };

    }
}



namespace EreIdentity.Api.Contracts.Responses;

public sealed record ApplicationConfigurationResult
{
    public required string ClientId { get; init; }
    public string? KeycloakConfiguration { get; init; }
    public string? CallbackUrl { get; init; }
    public DateTime UpdatedAt { get; init; }
}


