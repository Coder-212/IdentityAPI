/// <summary>
/// Generates Keycloak query files for users whose TOTP status must be checked.
/// </summary>
/// <remarks>
/// This job retrieves recent users that are not yet confirmed as TOTP-enabled,
/// groups them by client, resolves the related Keycloak service account configuration,
/// and creates one query Excel file per client.
/// </remarks>
public sealed class UserTotpStatusRequestJob : IJob
{
    private readonly ILogger<UserTotpStatusRequestJob> _logger;
    private readonly IUserProvisioningRepository _repository;
    private readonly KeyCloakSettings _keycloakSettings;
    private readonly IExcelHelperWrapper _excelHelperWrapper;
    private readonly IEreIdentityMongoContext _contextMongo;

    public UserTotpStatusRequestJob(
        IUserProvisioningRepository repository,
        ILogger<UserTotpStatusRequestJob> logger,
        IOptions<KeyCloakSettings> keycloakSettings,
        IExcelHelperWrapper excelHelperWrapper,
        IEreIdentityMongoContext contextMongo)
    {
        _repository = repository;
        _logger = logger;
        _keycloakSettings = keycloakSettings.Value;
        _excelHelperWrapper = excelHelperWrapper;
        _contextMongo = contextMongo;
    }

    public async Task Execute(IJobExecutionContext context)
    {
        _logger.LogInformation("Starting user TOTP status request job.");

        var users = (await _repository.GetRecentUsersNotConfirmedAsync()).ToList();

        if (users.Count == 0)
        {
            _logger.LogInformation("No recent users without confirmed TOTP status found.");
            return;
        }

        var usersWithClient = users
            .Where(x => !string.IsNullOrWhiteSpace(x.ClientId))
            .ToList();

        var usersWithoutClient = users
            .Where(x => string.IsNullOrWhiteSpace(x.ClientId))
            .ToList();

        if (usersWithoutClient.Count > 0)
        {
            _logger.LogWarning(
                "{Count} users cannot be queried because ClientId is missing.",
                usersWithoutClient.Count);
        }

        var clientIds = usersWithClient
            .Select(x => x.ClientId!)
            .Distinct()
            .ToList();

        var applicationInfos = await _contextMongo.GetApplicationInfosAsync(
            clientIds,
            context.CancellationToken);

        var serviceAccountsByClient = applicationInfos
            .GroupBy(x => x.ClientId)
            .ToDictionary(
                x => x.Key,
                x => x.First().KeycloakConfiguration);

        foreach (var group in usersWithClient.GroupBy(x => x.ClientId))
        {
            context.CancellationToken.ThrowIfCancellationRequested();

            var clientId = group.Key!;
            var userList = group.ToList();

            if (!serviceAccountsByClient.TryGetValue(clientId, out var serviceAccount))
            {
                _logger.LogWarning(
                    "No Keycloak configuration found for client {ClientId}.",
                    clientId);

                continue;
            }

            var emails = userList
                .Select(x => x.Email)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (emails.Count == 0)
            {
                _logger.LogWarning(
                    "No valid email found for client {ClientId}.",
                    clientId);

                continue;
            }

            _logger.LogInformation(
                "Creating TOTP status query file for client {ClientId}. User count: {Count}.",
                clientId,
                emails.Count);

            _excelHelperWrapper.CreateReadQueryExcel(
                emails,
                _keycloakSettings.FilePath,
                serviceAccount);
        }

        _logger.LogInformation("End user TOTP status request job.");
    }
}
