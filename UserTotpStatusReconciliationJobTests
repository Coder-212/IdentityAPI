using EreIdentity.Application.Interfaces;
using EreIdentity.Infrastructure.Configurations;
using EreIdentity.Infrastructure.Keycloak;
using FluentAssertions;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Options;
using NSubstitute;
using Quartz;

namespace EreIdentity.Tests.Infrastructure;

public sealed class UserTotpStatusReconciliationJobTests : IDisposable
{
    private readonly string _outputDirectory;
    private readonly IUserProvisioningRepository _repository;
    private readonly IExcelHelperWrapper _excelHelperWrapper;
    private readonly ILogger<UserTotpStatusReconciliationJob> _logger;
    private readonly UserTotpStatusReconciliationJob _job;

    public UserTotpStatusReconciliationJobTests()
    {
        _outputDirectory = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N"));
        Directory.CreateDirectory(_outputDirectory);

        _repository = Substitute.For<IUserProvisioningRepository>();
        _excelHelperWrapper = Substitute.For<IExcelHelperWrapper>();
        _logger = Substitute.For<ILogger<UserTotpStatusReconciliationJob>>();

        var options = Options.Create(new KeyCloakSettings
        {
            FileOutPut = _outputDirectory
        });

        _job = new UserTotpStatusReconciliationJob(
            options,
            _repository,
            _logger,
            _excelHelperWrapper);
    }

    [Fact]
    public async Task Execute_Should_Do_Nothing_When_No_Output_File_Exists()
    {
        await _job.Execute(CreateContext());

        _excelHelperWrapper
            .DidNotReceive()
            .ReadAllOutPutData(
                Arg.Any<IEnumerable<string>>(),
                Arg.Any<ILogger>());
    }

    [Fact]
    public async Task Execute_Should_Create_Working_Directories()
    {
        await _job.Execute(CreateContext());

        Directory.Exists(Path.Combine(_outputDirectory, "processing")).Should().BeTrue();
        Directory.Exists(Path.Combine(_outputDirectory, "archive")).Should().BeTrue();
        Directory.Exists(Path.Combine(_outputDirectory, "error")).Should().BeTrue();
    }

    [Fact]
    public async Task Execute_Should_Read_Output_File_And_Archive_It()
    {
        var filePath = CreateOutputFile("output_001.xls");

        _excelHelperWrapper
            .ReadAllOutPutData(
                Arg.Any<IEnumerable<string>>(),
                _logger)
            .Returns([]);

        await _job.Execute(CreateContext());

        File.Exists(filePath).Should().BeFalse();

        Directory
            .EnumerateFiles(Path.Combine(_outputDirectory, "archive"))
            .Should()
            .ContainSingle(file => Path.GetFileName(file).StartsWith("output_001"));
    }

    [Fact]
    public async Task Execute_Should_Update_Totp_Status_When_User_Exists()
    {
        CreateOutputFile("output_002.xls");

        var output = new OutPutResult
        {
            UserName = "user@test.com",
            TOTPActive = true
        };

        var user = new IdentityUser
        {
            Email = "user@test.com",
            TotpEnabled = false
        };

        _excelHelperWrapper
            .ReadAllOutPutData(
                Arg.Any<IEnumerable<string>>(),
                _logger)
            .Returns([output]);

        _repository
            .GetUserByEmailAsync(output.UserName)
            .Returns(user);

        _repository
            .UpdateUserTotpStatusAsync(user.Email, output.TOTPActive)
            .Returns(Task.CompletedTask);

        await _job.Execute(CreateContext());

        await _repository
            .Received(1)
            .UpdateUserTotpStatusAsync(
                "user@test.com",
                true);
    }

    [Fact]
    public async Task Execute_Should_Not_Update_Totp_When_User_Does_Not_Exist()
    {
        CreateOutputFile("output_003.xls");

        var output = new OutPutResult
        {
            UserName = "missing@test.com",
            TOTPActive = true
        };

        _excelHelperWrapper
            .ReadAllOutPutData(
                Arg.Any<IEnumerable<string>>(),
                _logger)
            .Returns([output]);

        _repository
            .GetUserByEmailAsync(output.UserName)
            .Returns((IdentityUser?)null);

        await _job.Execute(CreateContext());

        await _repository
            .DidNotReceive()
            .UpdateUserTotpStatusAsync(
                Arg.Any<string>(),
                Arg.Any<bool>());
    }

    [Fact]
    public async Task Execute_Should_Ignore_Line_When_UserName_Is_Empty()
    {
        CreateOutputFile("output_004.xls");

        var output = new OutPutResult
        {
            UserName = "",
            TOTPActive = true
        };

        _excelHelperWrapper
            .ReadAllOutPutData(
                Arg.Any<IEnumerable<string>>(),
                _logger)
            .Returns([output]);

        await _job.Execute(CreateContext());

        await _repository
            .DidNotReceive()
            .GetUserByEmailAsync(Arg.Any<string>());

        await _repository
            .DidNotReceive()
            .UpdateUserTotpStatusAsync(
                Arg.Any<string>(),
                Arg.Any<bool>());
    }

    [Fact]
    public async Task Execute_Should_Continue_When_One_Line_Fails()
    {
        CreateOutputFile("output_005.xls");

        var firstOutput = new OutPutResult
        {
            UserName = "first@test.com",
            TOTPActive = true
        };

        var secondOutput = new OutPutResult
        {
            UserName = "second@test.com",
            TOTPActive = true
        };

        var secondUser = new IdentityUser
        {
            Email = "second@test.com"
        };

        _excelHelperWrapper
            .ReadAllOutPutData(
                Arg.Any<IEnumerable<string>>(),
                _logger)
            .Returns([firstOutput, secondOutput]);

        _repository
            .GetUserByEmailAsync(firstOutput.UserName)
            .Returns<Task<IdentityUser?>>(_ => throw new InvalidOperationException("technical error"));

        _repository
            .GetUserByEmailAsync(secondOutput.UserName)
            .Returns(secondUser);

        _repository
            .UpdateUserTotpStatusAsync(secondUser.Email, secondOutput.TOTPActive)
            .Returns(Task.CompletedTask);

        await _job.Execute(CreateContext());

        await _repository
            .Received(1)
            .UpdateUserTotpStatusAsync(
                "second@test.com",
                true);

        Directory
            .EnumerateFiles(Path.Combine(_outputDirectory, "archive"))
            .Should()
            .ContainSingle();
    }

    [Fact]
    public async Task Execute_Should_Move_File_To_Error_When_ReadAllOutputData_Throws()
    {
        var filePath = CreateOutputFile("output_006.xls");

        _excelHelperWrapper
            .When(x => x.ReadAllOutPutData(
                Arg.Any<IEnumerable<string>>(),
                _logger))
            .Do(_ => throw new InvalidOperationException("invalid file"));

        await _job.Execute(CreateContext());

        File.Exists(filePath).Should().BeFalse();

        Directory
            .EnumerateFiles(Path.Combine(_outputDirectory, "error"))
            .Should()
            .ContainSingle(file => Path.GetFileName(file).StartsWith("output_006"));
    }

    private string CreateOutputFile(string fileName)
    {
        var filePath = Path.Combine(_outputDirectory, fileName);
        File.WriteAllText(filePath, "fake output content");
        return filePath;
    }

    private static IJobExecutionContext CreateContext()
    {
        var context = Substitute.For<IJobExecutionContext>();
        context.CancellationToken.Returns(CancellationToken.None);
        return context;
    }

    public void Dispose()
    {
        if (Directory.Exists(_outputDirectory))
        {
            Directory.Delete(_outputDirectory, recursive: true);
        }
    }
}
