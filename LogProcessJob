using System.Net.Http.Json;
using EreIdentity.Application.Interfaces;
using EreIdentity.Domain.Enum;
using EreIdentity.Infrastructure.Configurations;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Options;
using MongoDB.Driver;
using Quartz;

namespace EreIdentity.Infrastructure.Keycloak;

public sealed class LogProcessJob : IJob
{
    private readonly ILogger<LogProcessJob> _logger;
    private readonly IEreIdentityMongoContext _contextMongo;
    private readonly IUserProvisioningRepository _userProvisioningRepository;
    private readonly IHttpClientFactory _httpClientFactory;
    private readonly IExcelHelperWrapper _excelHelperWrapper;
    private readonly KeyCloakSettings _keycloakSettings;

    public LogProcessJob(
        IOptions<KeyCloakSettings> keycloakSettings,
        IEreIdentityMongoContext contextMongo,
        IUserProvisioningRepository userProvisioningRepository,
        ILogger<LogProcessJob> logger,
        IHttpClientFactory httpClientFactory,
        IExcelHelperWrapper excelHelperWrapper)
    {
        _keycloakSettings = keycloakSettings.Value;
        _contextMongo = contextMongo;
        _userProvisioningRepository = userProvisioningRepository;
        _logger = logger;
        _httpClientFactory = httpClientFactory;
        _excelHelperWrapper = excelHelperWrapper;
    }

    /// <summary>
    /// Processes Keycloak return files and reconciles provisioning requests.
    /// </summary>
    /// <remarks>
    /// This job reads Keycloak return/log files, finds the related in-progress provisioning request,
    /// updates the Users collection when needed, then updates the provisioning request status.
    ///
    /// Improvements:
    /// - moves each file to a processing directory before reading it;
    /// - isolates errors per file;
    /// - isolates errors per return line;
    /// - reconciles only InProgress requests;
    /// - handles duplicate users as idempotent success when Email has a unique index;
    /// - distinguishes retryable and non-retryable errors;
    /// - archives successfully processed files;
    /// - moves technically failed files to an error directory.
    ///
    /// Attention:
    /// - MarkDoneAsync, MarkFailedAsync and MarkAsCancelledAsync should filter on Id + Status == InProgress.
    /// - TryGetInProgressRequestAsync should use a deterministic sort, for example UpdatedAt DESC.
    /// - Matching by RequestId would be safer than Username + ProvisioningType if the return file can contain RequestId.
    /// </remarks>
    public async Task Execute(IJobExecutionContext context)
    {
        _logger.LogInformation("Starting Keycloak return file processing job.");

        var inputDirectory = _keycloakSettings.LogDirectory;
        var archiveDirectory = Path.Combine(inputDirectory, "archive");
        var processingDirectory = Path.Combine(inputDirectory, "processing");
        var errorDirectory = Path.Combine(inputDirectory, "error");

        // Attention vérifier que le compte d'exécution a les droits sur le dossier partagé.
        Directory.CreateDirectory(archiveDirectory);
        Directory.CreateDirectory(processingDirectory);
        Directory.CreateDirectory(errorDirectory);

        var filesToProcess = Directory
            .EnumerateFiles(inputDirectory, "*.*", SearchOption.TopDirectoryOnly)
            .Where(file =>
                Path.GetFileName(file).Contains("send_mail_log", StringComparison.OrdinalIgnoreCase))
            .OrderBy(File.GetCreationTimeUtc)
            .ToList();

        // Attention vérifier que "send_mail_log" couvre bien tous les fichiers retour Keycloak.
        if (filesToProcess.Count == 0)
        {
            _logger.LogInformation("No Keycloak return file found.");
            return;
        }

        _logger.LogInformation(
            "Found {Count} Keycloak return files to process.",
            filesToProcess.Count);

        foreach (var filePath in filesToProcess)
        {
            context.CancellationToken.ThrowIfCancellationRequested();

            await ProcessFileAsync(
                filePath,
                processingDirectory,
                archiveDirectory,
                errorDirectory,
                context.CancellationToken);
        }

        _logger.LogInformation("End Keycloak return file processing job.");
    }

    private async Task ProcessFileAsync(
        string sourceFilePath,
        string processingDirectory,
        string archiveDirectory,
        string errorDirectory,
        CancellationToken cancellationToken)
    {
        var fileName = Path.GetFileName(sourceFilePath);
        var processingFilePath = Path.Combine(processingDirectory, fileName);
        var archiveFilePath = Path.Combine(archiveDirectory, fileName);
        var errorFilePath = Path.Combine(errorDirectory, fileName);

        try
        {
            // Attention File.Move sert ici d'anti double-traitement entre plusieurs instances Job B.
            // À valider sur le partage réseau utilisé.
            MoveFileSafely(sourceFilePath, processingFilePath);

            _logger.LogInformation(
                "Processing Keycloak return file {FileName}.",
                fileName);

            var userLogs = _excelHelperWrapper
                .ReadAllLogs(processingFilePath, _logger)
                .ToList();

            if (userLogs.Count == 0)
            {
                _logger.LogWarning(
                    "Keycloak return file {FileName} contains no log lines.",
                    fileName);
            }

            var hasTechnicalLineError = false;

            foreach (var userLog in userLogs)
            {
                cancellationToken.ThrowIfCancellationRequested();

                try
                {
                    await ProcessUserLogAsync(userLog, cancellationToken);
                }
                catch (Exception ex)
                {
                    hasTechnicalLineError = true;

                    // Attention le fichier sera quand même archivé après traitement des autres lignes.
                    // Si tu veux rejouer tout le fichier en cas d'erreur ligne, il faut faire throw ici.
                    _logger.LogError(
                        ex,
                        "Failed to reconcile one return line. File: {FileName}, Username: {Username}, Type: {Type}, Result: {Result}",
                        fileName,
                        userLog.Username,
                        userLog.ProvisioningType,
                        userLog.Result);
                }
            }

            if (hasTechnicalLineError)
            {
                _logger.LogWarning(
                    "File {FileName} contains at least one technical line error but will still be archived.",
                    fileName);
            }

            MoveFileSafely(processingFilePath, archiveFilePath);

            _logger.LogInformation(
                "Keycloak return file {FileName} archived successfully.",
                fileName);
        }
        catch (IOException ex)
        {
            _logger.LogWarning(
                ex,
                "File {FileName} could not be moved or processed. It may already be handled by another job instance.",
                fileName);
        }
        catch (Exception ex)
        {
            _logger.LogError(
                ex,
                "Technical error while processing Keycloak return file {FileName}. Moving file to error directory.",
                fileName);

            // Attention le fichier déplacé en error ne sera pas automatiquement rejoué.
            TryMoveToError(processingFilePath, sourceFilePath, errorFilePath);
        }
    }

    private async Task ProcessUserLogAsync(
        UserLogResult userLog,
        CancellationToken cancellationToken)
    {
        // Attention idéalement matcher par RequestId si disponible dans le fichier retour.
        // Sinon TryGetInProgressRequestAsync doit trier de façon déterministe, par exemple UpdatedAt DESC.
        var requestRelated = await _contextMongo.TryGetInProgressRequestAsync(
            userLog.Username,
            userLog.ProvisioningType,
            cancellationToken);

        if (requestRelated is null)
        {
            _logger.LogWarning(
                "No InProgress provisioning request found for Username: {Username}, Type: {Type}.",
                userLog.Username,
                userLog.ProvisioningType);

            return;
        }

        _logger.LogInformation(
            "Reconciling InProgress provisioning request {RequestId}. Type: {Type}, Username: {Username}, Success: {Success}, Result: {Result}",
            requestRelated.Id,
            requestRelated.Type,
            userLog.Username,
            userLog.Success,
            userLog.Result);

        if (userLog.Success)
        {
            await HandleSuccessAsync(requestRelated, userLog, cancellationToken);
            return;
        }

        await HandleFailureAsync(requestRelated, userLog, cancellationToken);
    }

    private async Task HandleSuccessAsync(
        ProvisioningUserRequest requestRelated,
        UserLogResult userLog,
        CancellationToken cancellationToken)
    {
        if (requestRelated.Type == ProvisioningType.Create.ToString())
        {
            var user = new IdentityUser
            {
                UserId = requestRelated.UserId,
                Email = requestRelated.Email,
                FirstName = requestRelated.FirstName,
                LastName = requestRelated.LastName,
                RequestId = requestRelated.Id,
                PhoneNumber = requestRelated.PhoneNumber,
                EruId = requestRelated.EruId,
                Language = requestRelated.Language,
                ClientId = requestRelated.ClientId,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            try
            {
                await _userProvisioningRepository.CreateUserAsync(user);
            }
            catch (MongoWriteException ex) when (ex.WriteError.Category == ServerErrorCategory.DuplicateKey)
            {
                // Attention ce comportement suppose que Email est unique dans Users.
                // Le duplicate est traité comme succès idempotent en cas de rejeu du fichier retour.
                _logger.LogWarning(
                    "User {Email} already exists. Continuing reconciliation as idempotent success.",
                    user.Email);
            }

            await SendCallbackIfAvailableAsync(
                requestRelated,
                userLog,
                cancellationToken);
        }

        if (requestRelated.Type == ProvisioningType.Update.ToString())
        {
            // Attention vérifier que cette méthode applique bien les données attendues.
            await _userProvisioningRepository.UpdateUserAsync(
                requestRelated.Email,
                cancellationToken);
        }

        if (requestRelated.Type == ProvisioningType.Delete.ToString())
        {
            // Attention vérifier si DeleteUserAsync est un delete physique ou un soft delete.
            var deleted = await _userProvisioningRepository.DeleteUserAsync(
                requestRelated.Email);

            _logger.LogInformation(
                "User deletion result for {Email}: {Deleted}",
                requestRelated.Email,
                deleted);
        }

        // Attention MarkDoneAsync doit filtrer sur Id + Status == InProgress.
        // Si possible, faire retourner bool pour détecter ModifiedCount == 0.
        await _contextMongo.MarkDoneAsync(
            requestRelated,
            userLog.Result,
            cancellationToken);

        _logger.LogInformation(
            "Provisioning request {RequestId} completed successfully.",
            requestRelated.Id);
    }

    private async Task HandleFailureAsync(
        ProvisioningUserRequest requestRelated,
        UserLogResult userLog,
        CancellationToken cancellationToken)
    {
        // Attention classification textuelle fragile. Idéalement utiliser des ErrorCode stables.
        var isRetryable = IsRetryableError(userLog.Result);
        var nextRetryCount = requestRelated.RetryCount + 1;

        if (!isRetryable || nextRetryCount >= _keycloakSettings.MaxRetryCount)
        {
            // Attention MarkAsCancelledAsync doit filtrer sur Id + Status == InProgress.
            await _contextMongo.MarkAsCancelledAsync(
                requestRelated.Id,
                userLog.Result,
                cancellationToken);

            _logger.LogWarning(
                "Provisioning request {RequestId} cancelled. Retryable: {IsRetryable}, NextRetryCount: {NextRetryCount}, MaxRetryCount: {MaxRetryCount}, Error: {Error}",
                requestRelated.Id,
                isRetryable,
                nextRetryCount,
                _keycloakSettings.MaxRetryCount,
                userLog.Result);

            return;
        }

        // Attention MarkFailedAsync doit incrémenter RetryCount une seule fois,
        // vider LockUntil et filtrer sur Id + Status == InProgress.
        await _contextMongo.MarkFailedAsync(
            requestRelated,
            userLog.Result,
            cancellationToken);

        _logger.LogWarning(
            "Provisioning request {RequestId} marked as failed. RetryCount will be incremented. Error: {Error}",
            requestRelated.Id,
            userLog.Result);
    }

    private async Task SendCallbackIfAvailableAsync(
        ProvisioningUserRequest requestRelated,
        UserLogResult userLog,
        CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(requestRelated.ClientId))
        {
            _logger.LogWarning(
                "Cannot send callback because ClientId is missing for request {RequestId}.",
                requestRelated.Id);

            return;
        }

        // Attention adapter si ton contexte utilise GetApplicationInfosAsync au lieu de cette méthode.
        var applicationInfo = await _contextMongo.GetApplicationInfoByClientIdAsync(
            requestRelated.ClientId,
            cancellationToken);

        if (applicationInfo?.CallbackUrl is null)
        {
            _logger.LogInformation(
                "No callback URL found for client {ClientId}.",
                requestRelated.ClientId);

            return;
        }

        try
        {
            // Attention vérifier que le client nommé "callbacks" est configuré dans le DI.
            var http = _httpClientFactory.CreateClient("callbacks");

            using var request = new HttpRequestMessage(
                HttpMethod.Post,
                applicationInfo.CallbackUrl)
            {
                Content = JsonContent.Create(userLog)
            };

            using var response = await http.SendAsync(
                request,
                cancellationToken);

            if (response.IsSuccessStatusCode)
            {
                _logger.LogInformation(
                    "Callback sent successfully for client {ClientId}.",
                    requestRelated.ClientId);
            }
            else
            {
                _logger.LogError(
                    "Callback failed for client {ClientId}. StatusCode: {StatusCode}",
                    requestRelated.ClientId,
                    response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            // Attention l'échec callback ne bloque pas la clôture de la request.
            _logger.LogError(
                ex,
                "Technical error while sending callback for client {ClientId}.",
                requestRelated.ClientId);
        }
    }

    private static bool IsRetryableError(string? result)
    {
        if (string.IsNullOrWhiteSpace(result))
        {
            return true;
        }

        return result.Contains("timeout", StringComparison.OrdinalIgnoreCase)
            || result.Contains("temporarily", StringComparison.OrdinalIgnoreCase)
            || result.Contains("technical", StringComparison.OrdinalIgnoreCase)
            || result.Contains("unavailable", StringComparison.OrdinalIgnoreCase)
            || result.Contains("503", StringComparison.OrdinalIgnoreCase)
            || result.Contains("502", StringComparison.OrdinalIgnoreCase)
            || result.Contains("504", StringComparison.OrdinalIgnoreCase);
    }

    private static void MoveFileSafely(string sourcePath, string destinationPath)
    {
        if (!File.Exists(sourcePath))
        {
            throw new FileNotFoundException(
                "Source file was not found.",
                sourcePath);
        }

        if (File.Exists(destinationPath))
        {
            var directory = Path.GetDirectoryName(destinationPath)!;
            var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(destinationPath);
            var extension = Path.GetExtension(destinationPath);

            destinationPath = Path.Combine(
                directory,
                $"{fileNameWithoutExtension}_{DateTime.UtcNow:yyyyMMddHHmmssfff}_{Guid.NewGuid():N}{extension}");
        }

        File.Move(sourcePath, destinationPath);
    }

    private void TryMoveToError(
        string processingFilePath,
        string sourceFilePath,
        string errorFilePath)
    {
        try
        {
            if (File.Exists(processingFilePath))
            {
                MoveFileSafely(processingFilePath, errorFilePath);
                return;
            }

            if (File.Exists(sourceFilePath))
            {
                MoveFileSafely(sourceFilePath, errorFilePath);
            }
        }
        catch (Exception moveException)
        {
            _logger.LogError(
                moveException,
                "Failed to move file to error directory.");
        }
    }
}
