using System.Net;
using EreIdentity.Application.Interfaces;
using EreIdentity.Domain.Enum;
using EreIdentity.Infrastructure.Configurations;
using EreIdentity.Infrastructure.Keycloak;
using FluentAssertions;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Options;
using MongoDB.Driver;
using NSubstitute;
using Quartz;

namespace EreIdentity.Infrastructure.Tests.Keycloak;

public sealed class UserProvisioningReconciliationJobTests : IDisposable
{
    private readonly string _logDirectory;
    private readonly IEreIdentityMongoContext _contextMongo;
    private readonly IUserProvisioningRepository _userRepository;
    private readonly ILogger<UserProvisioningReconciliationJob> _logger;
    private readonly IHttpClientFactory _httpClientFactory;
    private readonly IExcelHelperWrapper _excelHelperWrapper;
    private readonly UserProvisioningReconciliationJob _job;

    public UserProvisioningReconciliationJobTests()
    {
        _logDirectory = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N"));
        Directory.CreateDirectory(_logDirectory);

        _contextMongo = Substitute.For<IEreIdentityMongoContext>();
        _userRepository = Substitute.For<IUserProvisioningRepository>();
        _logger = Substitute.For<ILogger<UserProvisioningReconciliationJob>>();
        _httpClientFactory = Substitute.For<IHttpClientFactory>();
        _excelHelperWrapper = Substitute.For<IExcelHelperWrapper>();

        var options = Options.Create(new KeyCloakSettings
        {
            LogDirectory = _logDirectory,
            MaxRetryCount = 3
        });

        _job = new UserProvisioningReconciliationJob(
            options,
            _contextMongo,
            _userRepository,
            _logger,
            _httpClientFactory,
            _excelHelperWrapper);
    }

    [Fact]
    public async Task Execute_Should_Do_Nothing_When_No_Return_File_Exists()
    {
        var context = CreateJobContext();

        await _job.Execute(context);

        _excelHelperWrapper
            .DidNotReceive()
            .ReadAllLogs(Arg.Any<string>(), Arg.Any<ILogger>());

        await _contextMongo
            .DidNotReceive()
            .TryGetInProgressRequestAsync(
                Arg.Any<string>(),
                Arg.Any<ProvisioningType>(),
                Arg.Any<CancellationToken>());
    }

    [Fact]
    public async Task Execute_Should_Create_Working_Directories()
    {
        await _job.Execute(CreateJobContext());

        Directory.Exists(Path.Combine(_logDirectory, "processing")).Should().BeTrue();
        Directory.Exists(Path.Combine(_logDirectory, "archive")).Should().BeTrue();
        Directory.Exists(Path.Combine(_logDirectory, "error")).Should().BeTrue();
    }

    [Fact]
    public async Task Execute_Should_Read_Return_File_And_Archive_It()
    {
        var sourceFile = CreateReturnFile("send_mail_log_create.xlsx");

        _excelHelperWrapper
            .ReadAllLogs(Arg.Any<string>(), _logger)
            .Returns([]);

        await _job.Execute(CreateJobContext());

        File.Exists(sourceFile).Should().BeFalse();

        Directory
            .EnumerateFiles(Path.Combine(_logDirectory, "archive"))
            .Should()
            .ContainSingle(file => Path.GetFileName(file).StartsWith("send_mail_log_create"));
    }

    [Fact]
    public async Task Execute_Should_Not_Update_When_No_InProgress_Request_Found()
    {
        CreateReturnFile("send_mail_log_missing.xlsx");

        var userLog = CreateUserLog(
            "missing@test.com",
            ProvisioningType.Create,
            success: true);

        _excelHelperWrapper
            .ReadAllLogs(Arg.Any<string>(), _logger)
            .Returns([userLog]);

        _contextMongo
            .TryGetInProgressRequestAsync(
                userLog.Username,
                userLog.ProvisioningType,
                Arg.Any<CancellationToken>())
            .Returns((ProvisioningUserRequest?)null);

        await _job.Execute(CreateJobContext());

        await _userRepository
            .DidNotReceive()
            .CreateUserAsync(Arg.Any<IdentityUser>());

        await _contextMongo
            .DidNotReceive()
            .MarkDoneAsync(
                Arg.Any<ProvisioningUserRequest>(),
                Arg.Any<string>(),
                Arg.Any<CancellationToken>());
    }

    [Fact]
    public async Task Execute_Should_Create_User_And_MarkDone_When_Create_Succeeds()
    {
        CreateReturnFile("send_mail_log_create_success.xlsx");

        var userLog = CreateUserLog(
            "create@test.com",
            ProvisioningType.Create,
            success: true);

        var request = CreateRequest(
            ProvisioningType.Create,
            "create@test.com");

        _excelHelperWrapper
            .ReadAllLogs(Arg.Any<string>(), _logger)
            .Returns([userLog]);

        _contextMongo
            .TryGetInProgressRequestAsync(
                userLog.Username,
                userLog.ProvisioningType,
                Arg.Any<CancellationToken>())
            .Returns(request);

        _contextMongo
            .MarkDoneAsync(request, userLog.Result, Arg.Any<CancellationToken>())
            .Returns(true);

        await _job.Execute(CreateJobContext());

        await _userRepository
            .Received(1)
            .CreateUserAsync(Arg.Is<IdentityUser>(user =>
                user.Email == request.Email &&
                user.UserId == request.UserId &&
                user.RequestId == request.Id));

        await _contextMongo
            .Received(1)
            .MarkDoneAsync(
                request,
                userLog.Result,
                Arg.Any<CancellationToken>());
    }

    [Fact]
    public async Task Execute_Should_Continue_When_Create_User_Already_Exists()
    {
        CreateReturnFile("send_mail_log_duplicate.xlsx");

        var userLog = CreateUserLog(
            "duplicate@test.com",
            ProvisioningType.Create,
            success: true);

        var request = CreateRequest(
            ProvisioningType.Create,
            "duplicate@test.com");

        _excelHelperWrapper
            .ReadAllLogs(Arg.Any<string>(), _logger)
            .Returns([userLog]);

        _contextMongo
            .TryGetInProgressRequestAsync(
                userLog.Username,
                userLog.ProvisioningType,
                Arg.Any<CancellationToken>())
            .Returns(request);

        _userRepository
            .When(repository => repository.CreateUserAsync(Arg.Any<IdentityUser>()))
            .Do(_ => throw CreateDuplicateKeyException());

        _contextMongo
            .MarkDoneAsync(request, userLog.Result, Arg.Any<CancellationToken>())
            .Returns(true);

        await _job.Execute(CreateJobContext());

        await _contextMongo
            .Received(1)
            .MarkDoneAsync(
                request,
                userLog.Result,
                Arg.Any<CancellationToken>());
    }

    [Fact]
    public async Task Execute_Should_Update_User_And_MarkDone_When_Update_Succeeds()
    {
        CreateReturnFile("send_mail_log_update_success.xlsx");

        var userLog = CreateUserLog(
            "update@test.com",
            ProvisioningType.Update,
            success: true);

        var request = CreateRequest(
            ProvisioningType.Update,
            "update@test.com");

        _excelHelperWrapper
            .ReadAllLogs(Arg.Any<string>(), _logger)
            .Returns([userLog]);

        _contextMongo
            .TryGetInProgressRequestAsync(
                userLog.Username,
                userLog.ProvisioningType,
                Arg.Any<CancellationToken>())
            .Returns(request);

        _userRepository
            .UpdateUserAsync(Arg.Any<IdentityUser>(), Arg.Any<CancellationToken>())
            .Returns(true);

        _contextMongo
            .MarkDoneAsync(request, userLog.Result, Arg.Any<CancellationToken>())
            .Returns(true);

        await _job.Execute(CreateJobContext());

        await _userRepository
            .Received(1)
            .UpdateUserAsync(
                Arg.Is<IdentityUser>(user => user.Email == request.Email),
                Arg.Any<CancellationToken>());

        await _contextMongo
            .Received(1)
            .MarkDoneAsync(
                request,
                userLog.Result,
                Arg.Any<CancellationToken>());
    }

    [Fact]
    public async Task Execute_Should_Delete_User_And_MarkDone_When_Delete_Succeeds()
    {
        CreateReturnFile("send_mail_log_delete_success.xlsx");

        var userLog = CreateUserLog(
            "delete@test.com",
            ProvisioningType.Delete,
            success: true);

        var request = CreateRequest(
            ProvisioningType.Delete,
            "delete@test.com");

        _excelHelperWrapper
            .ReadAllLogs(Arg.Any<string>(), _logger)
            .Returns([userLog]);

        _contextMongo
            .TryGetInProgressRequestAsync(
                userLog.Username,
                userLog.ProvisioningType,
                Arg.Any<CancellationToken>())
            .Returns(request);

        _userRepository
            .DeleteUserAsync(request.Email)
            .Returns(true);

        _contextMongo
            .MarkDoneAsync(request, userLog.Result, Arg.Any<CancellationToken>())
            .Returns(true);

        await _job.Execute(CreateJobContext());

        await _userRepository
            .Received(1)
            .DeleteUserAsync(request.Email);

        await _contextMongo
            .Received(1)
            .MarkDoneAsync(
                request,
                userLog.Result,
                Arg.Any<CancellationToken>());
    }

    [Fact]
    public async Task Execute_Should_MarkFailed_When_Request_Fails_And_MaxRetry_Not_Reached()
    {
        CreateReturnFile("send_mail_log_failed_retryable.xlsx");

        var userLog = CreateUserLog(
            "failed@test.com",
            ProvisioningType.Create,
            success: false,
            result: "technical error");

        var request = CreateRequest(
            ProvisioningType.Create,
            "failed@test.com",
            retryCount: 1);

        _excelHelperWrapper
            .ReadAllLogs(Arg.Any<string>(), _logger)
            .Returns([userLog]);

        _contextMongo
            .TryGetInProgressRequestAsync(
                userLog.Username,
                userLog.ProvisioningType,
                Arg.Any<CancellationToken>())
            .Returns(request);

        _contextMongo
            .MarkFailedAsync(request, userLog.Result, Arg.Any<CancellationToken>())
            .Returns(true);

        await _job.Execute(CreateJobContext());

        await _contextMongo
            .Received(1)
            .MarkFailedAsync(
                request,
                userLog.Result,
                Arg.Any<CancellationToken>());

        await _contextMongo
            .DidNotReceive()
            .MarkAsCancelledAsync(
                Arg.Any<ProvisioningUserRequest>(),
                Arg.Any<string>(),
                Arg.Any<CancellationToken>());
    }

    [Fact]
    public async Task Execute_Should_Cancel_When_MaxRetry_Is_Reached()
    {
        CreateReturnFile("send_mail_log_cancelled.xlsx");

        var userLog = CreateUserLog(
            "cancel@test.com",
            ProvisioningType.Create,
            success: false,
            result: "technical error");

        var request = CreateRequest(
            ProvisioningType.Create,
            "cancel@test.com",
            retryCount: 2);

        _excelHelperWrapper
            .ReadAllLogs(Arg.Any<string>(), _logger)
            .Returns([userLog]);

        _contextMongo
            .TryGetInProgressRequestAsync(
                userLog.Username,
                userLog.ProvisioningType,
                Arg.Any<CancellationToken>())
            .Returns(request);

        _contextMongo
            .MarkAsCancelledAsync(request, userLog.Result, Arg.Any<CancellationToken>())
            .Returns(true);

        await _job.Execute(CreateJobContext());

        await _contextMongo
            .Received(1)
            .MarkAsCancelledAsync(
                request,
                userLog.Result,
                Arg.Any<CancellationToken>());

        await _contextMongo
            .DidNotReceive()
            .MarkFailedAsync(
                Arg.Any<ProvisioningUserRequest>(),
                Arg.Any<string>(),
                Arg.Any<CancellationToken>());
    }

    [Fact]
    public async Task Execute_Should_Continue_When_One_Line_Throws()
    {
        CreateReturnFile("send_mail_log_two_lines.xlsx");

        var firstLog = CreateUserLog(
            "first@test.com",
            ProvisioningType.Create,
            success: true);

        var secondLog = CreateUserLog(
            "second@test.com",
            ProvisioningType.Create,
            success: true);

        var secondRequest = CreateRequest(
            ProvisioningType.Create,
            "second@test.com");

        _excelHelperWrapper
            .ReadAllLogs(Arg.Any<string>(), _logger)
            .Returns([firstLog, secondLog]);

        _contextMongo
            .TryGetInProgressRequestAsync(
                firstLog.Username,
                firstLog.ProvisioningType,
                Arg.Any<CancellationToken>())
            .Returns<Task<ProvisioningUserRequest?>>(_ =>
                throw new InvalidOperationException("technical line error"));

        _contextMongo
            .TryGetInProgressRequestAsync(
                secondLog.Username,
                secondLog.ProvisioningType,
                Arg.Any<CancellationToken>())
            .Returns(secondRequest);

        _contextMongo
            .MarkDoneAsync(secondRequest, secondLog.Result, Arg.Any<CancellationToken>())
            .Returns(true);

        await _job.Execute(CreateJobContext());

        await _contextMongo
            .Received(1)
            .MarkDoneAsync(
                secondRequest,
                secondLog.Result,
                Arg.Any<CancellationToken>());

        Directory
            .EnumerateFiles(Path.Combine(_logDirectory, "archive"))
            .Should()
            .ContainSingle();
    }

    private string CreateReturnFile(string fileName)
    {
        var filePath = Path.Combine(_logDirectory, fileName);
        File.WriteAllText(filePath, "fake-content");
        return filePath;
    }

    private static BulkUploadLogResult CreateUserLog(
        string username,
        ProvisioningType type,
        bool success,
        string result = "OK")
    {
        return new BulkUploadLogResult
        {
            Username = username,
            ProvisioningType = type,
            IsSuccess = success,
            Result = result
        };
    }

    private static ProvisioningUserRequest CreateRequest(
        ProvisioningType type,
        string email,
        int retryCount = 0)
    {
        return new ProvisioningUserRequest
        {
            Id = Guid.NewGuid().ToString("N"),
            UserId = email,
            Email = email,
            FirstName = "Test",
            LastName = "User",
            PhoneNumber = "+33123456789",
            EruId = "eru-test",
            Language = "fr",
            ClientId = "client-test",
            Type = type.ToString(),
            Status = ProvisioningStatus.InProgress.ToString(),
            RetryCount = retryCount,
            CreatedAt = DateTime.UtcNow.AddMinutes(-10),
            UpdatedAt = DateTime.UtcNow,
            LockUntil = DateTime.UtcNow.AddMinutes(5)
        };
    }

    private static IJobExecutionContext CreateJobContext()
    {
        var context = Substitute.For<IJobExecutionContext>();
        context.CancellationToken.Returns(CancellationToken.None);
        return context;
    }

    private static MongoWriteException CreateDuplicateKeyException()
    {
        var connectionId = new MongoDB.Driver.Core.Connections.ConnectionId(
            new MongoDB.Driver.Core.Servers.ServerId(
                new MongoDB.Driver.Core.Clusters.ClusterId(),
                new MongoDB.Driver.Core.Servers.ServerAddress("localhost", 27017)));

        var writeError = new WriteError(
            ServerErrorCategory.DuplicateKey,
            11000,
            "Duplicate key",
            new MongoDB.Bson.BsonDocument());

        return new MongoWriteException(connectionId, writeError, null);
    }

    public void Dispose()
    {
        if (Directory.Exists(_logDirectory))
        {
            Directory.Delete(_logDirectory, recursive: true);
        }
    }
}
