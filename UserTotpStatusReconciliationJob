/// <summary>
/// Processes Keycloak TOTP status output files and updates users accordingly.
/// </summary>
/// <remarks>
/// This job reads Keycloak output files, finds the related user by email/username,
/// updates the TOTP status in MongoDB, then archives the processed files.
/// </remarks>
public sealed class UserTotpStatusReconciliationJob : IJob
{
    private readonly KeyCloakSettings _keycloakSettings;
    private readonly string _outputDirectory;
    private readonly ILogger<UserTotpStatusReconciliationJob> _logger;
    private readonly IExcelHelperWrapper _excelHelperWrapper;
    private readonly IUserProvisioningRepository _repository;

    public UserTotpStatusReconciliationJob(
        IOptions<KeyCloakSettings> keycloakSettings,
        IUserProvisioningRepository repository,
        ILogger<UserTotpStatusReconciliationJob> logger,
        IExcelHelperWrapper excelHelperWrapper)
    {
        _keycloakSettings = keycloakSettings.Value;
        _outputDirectory = _keycloakSettings.FileOutPut;
        _repository = repository;
        _logger = logger;
        _excelHelperWrapper = excelHelperWrapper;
    }

    public async Task Execute(IJobExecutionContext context)
    {
        _logger.LogInformation("Starting user TOTP status reconciliation job.");

        var archiveDirectory = Path.Combine(_outputDirectory, "archive");
        var processingDirectory = Path.Combine(_outputDirectory, "processing");
        var errorDirectory = Path.Combine(_outputDirectory, "error");

        Directory.CreateDirectory(archiveDirectory);
        Directory.CreateDirectory(processingDirectory);
        Directory.CreateDirectory(errorDirectory);

        var files = Directory
            .EnumerateFiles(_outputDirectory, "*.xls", SearchOption.TopDirectoryOnly)
            .OrderBy(File.GetCreationTimeUtc)
            .ToList();

        if (files.Count == 0)
        {
            _logger.LogInformation("No Keycloak TOTP output file found.");
            return;
        }

        foreach (var filePath in files)
        {
            context.CancellationToken.ThrowIfCancellationRequested();

            await ProcessFileAsync(
                filePath,
                processingDirectory,
                archiveDirectory,
                errorDirectory,
                context.CancellationToken);
        }

        _logger.LogInformation("End user TOTP status reconciliation job.");
    }

    private async Task ProcessFileAsync(
        string sourceFilePath,
        string processingDirectory,
        string archiveDirectory,
        string errorDirectory,
        CancellationToken cancellationToken)
    {
        var fileName = Path.GetFileName(sourceFilePath);
        var processingFilePath = Path.Combine(processingDirectory, fileName);
        var archiveFilePath = Path.Combine(archiveDirectory, fileName);
        var errorFilePath = Path.Combine(errorDirectory, fileName);

        try
        {
            // Attention : évite que deux instances du job traitent le même fichier.
            MoveFileSafely(sourceFilePath, processingFilePath);

            var outputs = _excelHelperWrapper
                .ReadAllOutPutData([processingFilePath], _logger)
                .ToList();

            if (outputs.Count == 0)
            {
                _logger.LogWarning(
                    "TOTP output file {FileName} contains no data.",
                    fileName);
            }

            foreach (var output in outputs)
            {
                cancellationToken.ThrowIfCancellationRequested();

                try
                {
                    await ProcessOutputAsync(output, cancellationToken);
                }
                catch (Exception ex)
                {
                    _logger.LogError(
                        ex,
                        "Failed to process TOTP output line. UserName: {UserName}.",
                        output.UserName);
                }
            }

            MoveFileSafely(processingFilePath, archiveFilePath);

            _logger.LogInformation(
                "TOTP output file {FileName} archived successfully.",
                fileName);
        }
        catch (Exception ex)
        {
            _logger.LogError(
                ex,
                "Technical error while processing TOTP output file {FileName}. Moving file to error directory.",
                fileName);

            TryMoveToError(processingFilePath, sourceFilePath, errorFilePath);
        }
    }

    private async Task ProcessOutputAsync(
        OutPutResult output,
        CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(output.UserName))
        {
            _logger.LogWarning("TOTP output line ignored because UserName is missing.");
            return;
        }

        var user = await _repository.GetUserByEmailAsync(output.UserName);

        if (user is null)
        {
            _logger.LogWarning(
                "User {UserName} does not exist. TOTP status will not be updated.",
                output.UserName);

            return;
        }

        var updated = await _repository.UpdateUserTotpStatusAsync(
            user.Email,
            output.TOTPActive);

        if (!updated)
        {
            _logger.LogWarning(
                "TOTP status was not updated for user {Email}.",
                user.Email);

            return;
        }

        _logger.LogInformation(
            "TOTP status updated for user {Email}. TotpEnabled: {TotpEnabled}.",
            user.Email,
            output.TOTPActive);
    }

    private static void MoveFileSafely(string sourcePath, string destinationPath)
    {
        if (!File.Exists(sourcePath))
        {
            throw new FileNotFoundException("Source file was not found.", sourcePath);
        }

        if (File.Exists(destinationPath))
        {
            var directory = Path.GetDirectoryName(destinationPath)!;
            var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(destinationPath);
            var extension = Path.GetExtension(destinationPath);

            destinationPath = Path.Combine(
                directory,
                $"{fileNameWithoutExtension}_{DateTime.UtcNow:yyyyMMddHHmmssfff}_{Guid.NewGuid():N}{extension}");
        }

        File.Move(sourcePath, destinationPath);
    }

    private void TryMoveToError(
        string processingFilePath,
        string sourceFilePath,
        string errorFilePath)
    {
        try
        {
            if (File.Exists(processingFilePath))
            {
                MoveFileSafely(processingFilePath, errorFilePath);
                return;
            }

            if (File.Exists(sourceFilePath))
            {
                MoveFileSafely(sourceFilePath, errorFilePath);
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to move TOTP output file to error directory.");
        }
    }
}
